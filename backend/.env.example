# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hrm

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# First superuser (seeded automatically on server start)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=ChangeMe@123

# Google SMTP (use a Gmail App Password, NOT your Gmail password:
# Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="LR HRM <yourgmail@gmail.com>"

# Frontend URL (used in emails)
CLIENT_URL=http://localhost:3000
