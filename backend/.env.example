# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/logicrays_hrm?schema=public"

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Superuser + default user password (seeded automatically)
SUPERUSER_EMAIL=admin@logicrays.com
SUPERUSER_PASSWORD=LogicRays@2026

# Default password assigned to newly created users
DEFAULT_USER_PASSWORD=LogicRays@2026

# Frontend URL (CORS origin)
CLIENT_URL=http://localhost:3000
